# MongoDB connection string (cloud Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=cluster

# Frontend URL allowed by CORS (in production: your deployed frontend URL)
CLIENT_URL=http://localhost:5173

# bcrypt hash of the admin password (generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))")
ADMIN_PASSWORD_HASH=your-bcrypt-hash

# Long random token shared with the admin frontend
ADMIN_TOKEN=your-long-random-token
